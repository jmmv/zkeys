# zkeys configuration file.
#
# Keep this file readable only by root.  It contains credentials that retrieve
# secrets from the ZKeys service.

service_url = "https://zkeys.jmmv.dev/"

# Replace the key name and these values with your credentials.
[keys.example]
id = "01234567-89ab-cdef-0123-4567890abcde"
remote_password = "replace-with-the-remote-password"
local_secret = "replace-with-the-local-secret"

# Associate ZFS encryption roots with keys.  Dataset names containing slashes
# must be quoted.
#[zfs."pool/example"]
#key = "example"
